VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'LFL'  ;      
CREATE MEMBER CURRENTCUBE.[Measures].[КП LFL год-1 в день]
 AS [КП LFL год-1]/7, 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'LFL'  ;             
CREATE MEMBER CURRENTCUBE.[Measures].[КП LFL ]
 AS sum([LFL].[LFL].&amp;[True],[Число чеков ]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'LFL'  ;      
CREATE MEMBER CURRENTCUBE.[Measures].[КП LFL  в день]
 AS [КП LFL ]/7, 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'LFL'  ;             
CREATE MEMBER CURRENTCUBE.[Measures].[LFL КП прирост]
 AS [КП LFL ]/[КП LFL год-1]-1, 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Прирост показателей'  ;      
CREATE MEMBER CURRENTCUBE.[Measures].[LFL КП прирост день]
 AS [КП LFL  в день]/[КП LFL год-1 в день]-1, 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Прирост показателей'  ;             
CREATE MEMBER CURRENTCUBE.[Measures].[Число чеков прошлой недели]
 AS SUM(ParallelPeriod([Календарь].[ISO День-Неделя-Год].[ISO Неделя], 1, [Календарь].[ISO День-Неделя-Год].CurrentMember),
        [Число чеков по товару ШТ + Торнадо]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Чеки'  ;             
CREATE MEMBER CURRENTCUBE.[Measures].[Число чеков  за неделю]
 AS SUM([Календарь].[ISO День-Неделя-Год].CurrentMember,[Число чеков по товару ШТ + Торнадо]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Чеки'  ;             
CREATE MEMBER CURRENTCUBE.[Measures].[Прирост кол-ва чеков к прошлой неделе]
 AS [Число чеков  за неделю]/[Число чеков прошлой недели]-1, 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Прирост показателей'  ;             
CREATE MEMBER CURRENTCUBE.[Measures].[Средний Чек год -1]
 AS SUM(ParallelPeriod([Календарь].[ISO День-Неделя-Год].[ISO Год], 1, [Календарь].[ISO День-Неделя-Год].CurrentMember),[Средний Чек + Торнадо]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Чеки'  ;             
CREATE MEMBER CURRENTCUBE.[Measures].[Средний Чек  год]
 AS sum([Календарь].[ISO День-Неделя-Год].[ISO Год].&amp;[2024],[Средний Чек + Торнадо]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Чеки'  ;             
CREATE MEMBER CURRENTCUBE.[Measures].[Средний Чек неделя]
 AS SUM([Календарь].[ISO День-Неделя-Год].CurrentMember,[Средний Чек + Торнадо]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Чеки'  ;             
CREATE MEMBER CURRENTCUBE.[Measures].[Средний Чек прошлая неделя]
 AS SUM(ParallelPeriod([Календарь].[ISO День-Неделя-Год].[ISO Неделя], 1, [Календарь].[ISO День-Неделя-Год].CurrentMember),[Средний Чек + Торнадо]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Чеки'  ;      
CREATE MEMBER CURRENTCUBE.[Measures].[Средний Чек + Торнадо]
 AS [Measures].[Итоговая сумма чека со скидками РУБ]/([Measures].[Количество чеков ШТ]+[Measures].[Количество Чеков  Торнадо ШТ]), 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Торнадо'  ;             
CREATE MEMBER CURRENTCUBE.[Measures].[LFL Средний Чек год -1]
 AS sum([LFL].[LFL].&amp;[True],[Средний Чек год -1]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'LFL'  ;             
CREATE MEMBER CURRENTCUBE.[Measures].[LFL Средний Чек  год]
 AS sum([LFL].[LFL].&amp;[True],[Средний Чек + Торнадо]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'LFL'  ;             
CREATE MEMBER CURRENTCUBE.[Measures].[Прирост LFL Средний Чек  к прошлому году]
 AS [LFL Средний Чек  год]/[LFL Средний Чек год -1]-1, 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Прирост показателей'  ;             
CREATE MEMBER CURRENTCUBE.[Measures].[Прирост Средний Чек неделя к неделе]
 AS [Средний Чек неделя]/[Средний Чек прошлая неделя]-1, 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Прирост показателей'  ;             
CREATE MEMBER CURRENTCUBE.[Measures].[Прирост LFL Средний Чек  к прошлому году-Инфляция Общая]
 AS [Прирост LFL Средний Чек  к прошлому году]-[Measures].[Инфляция по сети], 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Прирост показателей'  ;             
CREATE MEMBER CURRENTCUBE.[Measures].[Сумма наценки LFL год -1]
 AS sum([LFL].[LFL].&amp;[True],[Наценка руб год -1]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'LFL'  ;             
CREATE MEMBER CURRENTCUBE.[Measures].[Сумма наценки LFL год]
 AS sum([LFL].[LFL].&amp;[True],[Наценка руб ]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'LFL'  ;             
CREATE MEMBER CURRENTCUBE.[Measures].[LFL прирост к прошлому году  сумма наценки]
 AS [Сумма наценки LFL год]/[Сумма наценки LFL год -1]-1, 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Прирост показателей'  ;             
CREATE MEMBER CURRENTCUBE.[Measures].[Наценка руб год -1]
 AS SUM(ParallelPeriod([Календарь].[ISO День-Неделя-Год].[ISO Год], 1, [Календарь].[ISO День-Неделя-Год].CurrentMember),[Наценка РУБ]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Товародвижение'  ;             
CREATE MEMBER CURRENTCUBE.[Measures].[Наценка руб ]
 AS SUM([Календарь].[ISO День-Неделя-Год].CurrentMember,[Наценка РУБ]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Товародвижение'  ;             
CREATE MEMBER CURRENTCUBE.[Measures].[Прирост наценки к прошлому году]
 AS [Наценка руб ]/[Наценка руб год -1]-1, 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Прирост показателей'  ;             
CREATE MEMBER CURRENTCUBE.[Measures].[Наценка прошлая неделя]
 AS SUM(ParallelPeriod([Календарь].[ISO День-Неделя-Год].[ISO Неделя], 1, [Календарь].[ISO День-Неделя-Год].CurrentMember),
        [Наценка РУБ]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Товародвижение'  ;             
CREATE MEMBER CURRENTCUBE.[Measures].[Наценка неделя]
 AS SUM([Календарь].[ISO День-Неделя-Год].CurrentMember,
        [Наценка РУБ]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Товародвижение'  ;             
CREATE MEMBER CURRENTCUBE.[Measures].[Прирост наценки к прошлой неделе]
 AS [Наценка неделя]/[Наценка прошлая неделя]-1, 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Прирост показателей'  ;     
CREATE MEMBER CURRENTCUBE.[Measures].[ Регулярные продажи РУБ]
 AS sum([Промо].[Флаг Промо].&amp;[False],[Measures].[Продажи с учетом возвратов и скидок + Торнадо РУБ ]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Детализация чеков'  ;     
CREATE MEMBER CURRENTCUBE.[Measures].[ Регулярные продажи ШТ КГ]
 AS sum([Промо].[Флаг Промо].&amp;[False],[Measures].[Количество проданного с учетом возвратов + Торнадо ШТ КГ]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Детализация чеков'  ;     
CREATE MEMBER CURRENTCUBE.[Measures].[ Промо продажи  РУБ]
 AS sum([Промо].[Флаг Промо].&amp;[True],[Measures].[Продажи с учетом возвратов и скидок + Торнадо РУБ ]), 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Промо'  ;     
CREATE MEMBER CURRENTCUBE.[Measures].[ Промо продажи  ШТ КГ]
 AS sum([Промо].[Флаг Промо].&amp;[True],[Measures].[Количество проданного с учетом возвратов + Торнадо ШТ КГ]), 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Промо'  ;   
CREATE MEMBER CURRENTCUBE.[Measures].[Инфляция ПРОЦ]
 AS iif(sum(ParallelPeriod([Календарь].[ISO День-Неделя-Год].[ISO Год],1,[Календарь].[ISO День-Неделя-Год].CurrentMember),[Количество проданного с учетом возвратов ШТ КГ])&gt;0, sum([Календарь].[ISO День-Неделя-Год].[ISO Неделя].CurrentMember,[Measures].[Количество проданного с учетом возвратов ШТ КГ])*sum(ParallelPeriod([Календарь].[ISO День-Неделя-Год].[ISO Год],1,[Календарь].[ISO День-Неделя-Год].CurrentMember),[Measures].[Средний чек по товару РУБ])/sum([Календарь].[ISO День-Неделя-Год].[ISO Неделя].CurrentMember,[Measures].[Продажи с учетом возвратов и скидок РУБ])-1, null), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Инфляция'  ;   
CREATE MEMBER CURRENTCUBE.[Measures].[Доля ВТ руб]
 AS ([Важный товар].[Важный товар со сценарием].[Важный товар].&amp;[True],[Measures].[Продажи с учетом возвратов и скидок + Торнадо РУБ ]
)/([Measures].[Продажи с учетом возвратов и скидок + Торнадо РУБ ]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'ДоляВТ'  ;   
CREATE MEMBER CURRENTCUBE.[Measures].[Доля ВТ шт]
 AS ([Важный товар].[Важный товар со сценарием].[Важный товар].&amp;[True],[Measures].[Количество проданного с учетом возвратов + Торнадо ШТ КГ]
)/([Количество проданного с учетом возвратов + Торнадо ШТ КГ]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'ДоляВТ'  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
