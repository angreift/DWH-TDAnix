        <Dimension xsi:type="RegularMeasureGroupDimension" dwd:design-time-name="2b93c963-da47-41ee-a115-3a3298c8921c">
          <CubeDimensionID>Товар</CubeDimensionID>
          <Attributes>
            <Attribute dwd:design-time-name="e33a03ed-c570-40dd-bce6-6b5976fdc6ed">
              <AttributeID>Код Товара</AttributeID>
              <KeyColumns>
                <KeyColumn dwd:design-time-name="1edb3b02-be03-4a31-8390-0c29080378f2">
                  <DataType>BigInt</DataType>
                  <Source xsi:type="ColumnBinding" dwd:design-time-name="cc22c95f-5cea-4394-b31a-450042027d0c">
                    <TableID>td_v_fact_Последний_приход</TableID>
                    <ColumnID>Код_товара</ColumnID>
                  </Source>
                </KeyColumn>
              </KeyColumns>
              <Type>Granularity</Type>
            </Attribute>
          </Attributes>
        </Dimension>
        <Dimension xsi:type="RegularMeasureGroupDimension" dwd:design-time-name="6b0ba570-7e1b-42dd-be41-5a94e5c510fb">
          <CubeDimensionID>Календарь</CubeDimensionID>
          <Attributes>
            <Attribute dwd:design-time-name="e0016b2c-f6da-4b8b-84e8-ab3730870d15">
              <AttributeID>ИД Дата</AttributeID>
              <KeyColumns>
                <KeyColumn dwd:design-time-name="04b743e9-7e79-442d-b8f7-8c111e104891">
                  <DataType>Date</DataType>
                  <Source xsi:type="ColumnBinding" dwd:design-time-name="f0998e5f-f6b2-4e35-bf90-7fae61a610c4">
                    <TableID>td_v_fact_Последний_приход</TableID>
                    <ColumnID>Дата_последнего_прихода</ColumnID>
                  </Source>
                </KeyColumn>
              </KeyColumns>
              <Type>Granularity</Type>
            </Attribute>
          </Attributes>
        </Dimension>
      </Dimensions>
    </MeasureGroup>
  </MeasureGroups>
  <Source dwd:design-time-name="df42825b-f2c9-4a77-b8a2-2f98ec8f57c4">
    <DataSourceViewID>DWH</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="894671b0-304d-4176-af74-0e5644ab2a6f">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CALCULATE;                                                                    
CREATE MEMBER CURRENTCUBE.MEASURES.UseAsDefaultMeasure
 AS NULL,
VISIBLE = 0;                                                               

ALTER CUBE CURRENTCUBE UPDATE DIMENSION Measures,
DEFAULT_MEMBER = [Measures].UseAsDefaultMeasure;                                                             
CREATE MEMBER CURRENTCUBE.[Measures].[Оборачиваемость дней]
 AS iif(sum([Вид товародвижения].[Вид товародвижения].&amp;[8], [Measures].[Количество ШТ КГ])&lt;&gt;0,
[Measures].[Средний остаток ШТ КГ]/sum([Вид товародвижения].[Вид товародвижения].&amp;[8], [Measures].[Количество ШТ КГ])*[Measures].[Кол-во дней]*-1, null), 
FORMAT_STRING = "Standard", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Остатки товара';    
CREATE MEMBER CURRENTCUBE.[Measures].[Оборачиваемость дней от тек.остатка]
 AS iif(sum([Вид товародвижения].[Вид товародвижения].&amp;[8], [Measures].[Количество ШТ КГ])&lt;&gt;0,
[Measures].[Остаток на начало дня ШТ КГ]/sum([Вид товародвижения].[Вид товародвижения].&amp;[8], [Measures].[Количество ШТ КГ])*[Measures].[Кол-во дней]*-1, null), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Остатки товара'  ;                                                                    

CREATE MEMBER CURRENTCUBE.[Measures].[Кража в розничных ценах РУБ]
 AS Sum([Причина товародвижения].[Причина].&amp;[32], [Measures].[Сумма движения товара РУБ]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Товародвижение';                                                                    
CREATE MEMBER CURRENTCUBE.[Measures].[Кража в закупочных ценах РУБ]
 AS Sum([Причина товародвижения].[Причина].&amp;[32], [Measures].[Сумма движения товара закупочная РУБ]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Товародвижение';                                                                    
CREATE MEMBER CURRENTCUBE.[Measures].[Форс-мажор в розничных ценах РУБ]
 AS Sum([Причина товародвижения].[Причина].&amp;[81], [Measures].[Сумма движения товара РУБ]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Товародвижение';                                                                    
CREATE MEMBER CURRENTCUBE.[Measures].[Переоценка в розничных ценах РУБ]
 AS sum([Вид товародвижения].[Вид товародвижения].&amp;[4], [Measures].[Сумма движения товара РУБ]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Товародвижение';                                                                    
CREATE MEMBER CURRENTCUBE.[Measures].[Переоценка в закупочных ценах РУБ]
 AS sum([Вид товародвижения].[Вид товародвижения].&amp;[4], [Measures].[Сумма движения товара закупочная РУБ]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Товародвижение';                                                                    
CREATE MEMBER CURRENTCUBE.[Measures].[Форс-мажор в закупочных ценах РУБ]
 AS Sum([Причина товародвижения].[Причина].&amp;[81], [Measures].[Сумма движения товара закупочная РУБ]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Товародвижение';                                                                     
CREATE MEMBER CURRENTCUBE.[Measures].[Списания на МОЛ в розничных ценах РУБ]
 AS Sum([Причина товародвижения].[Причина].&amp;[13], [Measures].[Сумма движения товара РУБ]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Товародвижение';                                                                     
CREATE MEMBER CURRENTCUBE.[Measures].[Списания на МОЛ в закупочных ценах РУБ]
 AS Sum([Причина товародвижения].[Причина].&amp;[13], [Measures].[Сумма движения товара закупочная РУБ]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Товародвижение';                                                                          
CREATE MEMBER CURRENTCUBE.[Measures].[Пенетрация ПРОЦ]
 AS iif(
    ([Measures].[Число чеков по товару ШТ]) = 0, null,
    ( [Measures].[Число чеков по товару ШТ]) / [Measures].[Количество чеков ШТ]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Детализация чеков';                                                                    
CREATE MEMBER CURRENTCUBE.[Measures].[Себестоимость продаж РУБ]
 AS sum({[Вид товародвижения].[Вид товародвижения].&amp;[8],[Вид товародвижения].[Вид товародвижения].&amp;[5]},[Measures].[Сумма движения товара закупочная со склада РУБ])*-1, 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Товародвижение';                                                                      
CREATE MEMBER CURRENTCUBE.[Measures].[Потери в розничных ценах РУБ]
 AS sum({[Причина товародвижения].[Категории причин товародвижения].[Категория].&amp;[2].CHILDREN,
[Причина товародвижения].[Категории причин товародвижения].[Категория].&amp;[16].CHILDREN
-[Причина товародвижения].[Категории причин товародвижения].[Причина].&amp;[43]
-[Причина товародвижения].[Категории причин товародвижения].[Причина].&amp;[56]},
 [Measures].[Сумма движения товара РУБ]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Товародвижение';                                                                      
CREATE MEMBER CURRENTCUBE.[Measures].[Потери в закупочных ценах РУБ]
 AS sum({[Причина товародвижения].[Категории причин товародвижения].[Категория].&amp;[2].CHILDREN,
[Причина товародвижения].[Категории причин товародвижения].[Категория].&amp;[16].CHILDREN
-[Причина товародвижения].[Категории причин товародвижения].[Причина].&amp;[43]
-[Причина товародвижения].[Категории причин товародвижения].[Причина].&amp;[56]},
[Measures].[Сумма движения товара закупочная со склада РУБ]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Товародвижение';                                            
																   
																																	  
																			 
CREATE MEMBER CURRENTCUBE.[Measures].[Средний чек по товару РУБ]
 AS iif([Продажи с учетом возвратов и скидок РУБ]=0,null,[Measures].[Продажи с учетом возвратов и скидок РУБ]/[Measures].[Число чеков по товару ШТ]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Детализация чеков';                                                                             
CREATE MEMBER CURRENTCUBE.[Measures].[Наценка РУБ]
 AS [Продажи с учетом возвратов и скидок РУБ] -sum({[Вид товародвижения].[Вид товародвижения].&amp;[8],[Вид товародвижения].[Вид товародвижения].&amp;[5]},[Measures].[Сумма движения товара закупочная со склада РУБ]) * (-1), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Товародвижение';                                                                             
CREATE MEMBER CURRENTCUBE.[Measures].[Наценка ПРОЦ]
 AS iif([Продажи с учетом возвратов и скидок РУБ]-[Наценка РУБ]=0,null,[Наценка РУБ]/([Продажи с учетом возвратов и скидок РУБ]-[Наценка РУБ])), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Товародвижение';                                           
CREATE MEMBER CURRENTCUBE.[Measures].[Цена закупочная]
 AS iif([Measures].[Количество ШТ КГ]=0,null,sum({[Вид товародвижения].[Вид товародвижения].&amp;[8],[Вид товародвижения].[Вид товародвижения].&amp;[5]},[Measures].[Сумма движения товара закупочная со склада РУБ])/sum({[Вид товародвижения].[Вид товародвижения].&amp;[8],[Вид товародвижения].[Вид товародвижения].&amp;[5]},[Measures].[Количество ШТ КГ])), 
NON_EMPTY_BEHAVIOR = { [Сумма движения товара закупочная со склада РУБ] }, 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Товародвижение';                                           
CREATE MEMBER CURRENTCUBE.[Measures].[Цена розничная]
 AS iif([Measures].[Количество ШТ КГ]=0,null,[Measures].[Сумма движения товара РУБ]/[Measures].[Количество ШТ КГ]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Товародвижение';                                        
CREATE MEMBER CURRENTCUBE.[Measures].[Время обслуживания покупателя СЕК]
 AS ([Возврат].[Объект является возвратом].&amp;[False],[Measures].[Длительность чека СЕК])/([Возврат].[Объект является возвратом].&amp;[False],[Measures].[Количество чеков ШТ]), 
FORMAT_STRING = "# ##0,00;-# ##0,00", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Чеки';                                        
CREATE MEMBER CURRENTCUBE.[Measures].[Время сканирования позиции СЕК]
 AS ([Возврат].[Объект является возвратом].&amp;[False],[Measures].[Длительность чека СЕК])/([Возврат].[Объект является возвратом].&amp;[False],[Measures].[Число позиций ШТ]), 
FORMAT_STRING = "# ##0,00;-# ##0,00", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Чеки';                                   
CREATE MEMBER CURRENTCUBE.[Measures].[Продажи 2024 РУБ]
 AS sum([Календарь].[День-Месяц-Год].[Год].&amp;[2024],[Measures].[Продажи с учетом возвратов и скидок РУБ]), 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Power BI'  ;                                    
CREATE MEMBER CURRENTCUBE.[Measures].[Продажи 2023 РУБ]
 AS sum([Календарь].[День-Месяц-Год].[Год].&amp;[2023],[Measures].[Продажи с учетом возвратов и скидок РУБ]), 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Power BI';                          
CREATE MEMBER CURRENTCUBE.[Measures].[Продажи 2022 РУБ]
 AS sum([Календарь].[День-Месяц-Год].[Год].&amp;[2022],[Measures].[Продажи с учетом возвратов и скидок РУБ]), 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Power BI'  ;                                        
CREATE MEMBER CURRENTCUBE.[Measures].[Служ. мера Дт Чеков=Чеки]
 AS iif([Measures].[Продажи с учетом возвратов и скидок РУБ]=[Measures].[Итоговая сумма чека со скидками РУБ],1,0), 
VISIBLE = 0 ,  ASSOCIATED_MEASURE_GROUP = 'Детализация чеков'  ;                                    
CREATE MEMBER CURRENTCUBE.[Measures].[План 2024]
 AS sum([Календарь].[День-Месяц-Год].[Год].&amp;[2024],[Measures].[Плановое значение]), 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Power BI';                                   
CREATE MEMBER CURRENTCUBE.[Measures].[Новинки РУБ]
 AS sum([Признак].[Признак].&amp;[4],[Measures].[Продажи с учетом возвратов и скидок РУБ]), 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Power BI' ,  ASSOCIATED_MEASURE_GROUP = 'Детализация чеков';                                  
CREATE MEMBER CURRENTCUBE.[Measures].[Скидка по ТСД РУБ]
 AS [Measures].[Сумма проданного без скидки по ТСД РУБ]-[Measures].[Сумма проданного со скидкой по ТСД РУБ], 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Продажи уцененного товара по ТСД';                              
CREATE MEMBER CURRENTCUBE.[Measures].[Себестоимость Торнадо РУБ]
 AS sum([Причина товародвижения].[Категории причин товародвижения].[Причина].&amp;[999],[Measures].[Сумма движения товара закупочная со склада РУБ])*-1, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Торнадо';                                 
CREATE MEMBER CURRENTCUBE.[Measures].[Полное Сторно Чека]
 AS ([Measures].[Сторнированные позиции].[Сторнирован Полностью], [Сторнированные Чеки Справочник].[bit])=1, 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Сторнированные позиции'  ;                                
CREATE MEMBER CURRENTCUBE.[Measures].[Число полностью сторнированных чеков]
 AS sum([Чек сторнирован полностью].[Полное сторно].&amp;[True],[Measures].[Число сторнированных чеков]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Сторнированные позиции';                              
CREATE MEMBER CURRENTCUBE.[Measures].[KeySelDate]
 AS format(cdate((existing [Календарь].[День-Месяц-Год].[День]).Item((existing [Календарь].[День-Месяц-Год].[День]).count-1).Properties("key")),"yyyy-MM-ddTHH:mm:ss"), 
VISIBLE = 0;                              
CREATE MEMBER CURRENTCUBE.[Measures].[KeySelDate60]
 AS iif([Measures].[KeySelDate]="2031-01-01T00:00:00",null,
format(cdate(
StrToMember("[Календарь].[День-Месяц-Год].[День].&amp;["+[Measures].[KeySelDate]+"]").lag(60).Properties("key")),
"yyyy-MM-ddTHH:mm:ss")), 
VISIBLE = 0;                              
CREATE MEMBER CURRENTCUBE.[Measures].[Непроды РУБ]
 AS iif(
[Measures].[Остаток ШТ КГ]&gt;0,
iif(sum(StrToMember("[Календарь].[День-Месяц-Год].[День].&amp;["+[Measures].[KeySelDate60]+"]")
:StrToMember("[Календарь].[День-Месяц-Год].[День].&amp;["+[Measures].[KeySelDate]+"]")
,[Measures].[Количество проданного с учетом возвратов ШТ КГ])&gt;0
,null,[Measures].[Сумма закупа со склада РУБ]),null), 
VISIBLE = 0 ,  ASSOCIATED_MEASURE_GROUP = 'Остатки товара'  ;                              
CREATE MEMBER CURRENTCUBE.[Measures].[Непроды шт]
 AS iif([Measures].[Остаток ШТ КГ]&gt;0,
iif(sum(StrToMember("[Календарь].[День-Месяц-Год].[День].&amp;["+[Measures].[KeySelDate60]+"]")
:StrToMember("[Календарь].[День-Месяц-Год].[День].&amp;["+[Measures].[KeySelDate]+"]")
,[Measures].[Количество проданного с учетом возвратов ШТ КГ])&gt;0
,null,[Measures].[Остаток ШТ КГ]),null), 
VISIBLE = 0 ,  ASSOCIATED_MEASURE_GROUP = 'Остатки товара'  ;                              
CREATE MEMBER CURRENTCUBE.[Measures].[Продажи Торнадо РУБ]
 AS sum([Причина товародвижения].[Категории причин товародвижения].[Причина].&amp;[999],[Measures].[Сумма движения товара РУБ])*-1, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Торнадо';                              
CREATE MEMBER CURRENTCUBE.[Measures].[Продажи Торнадо ШТ]
 AS sum([Причина товародвижения].[Категории причин товародвижения].[Причина].&amp;[999],[Measures].[Количество ШТ КГ])*-1, 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Торнадо';                                                                            
CREATE MEMBER CURRENTCUBE.[Measures].[Средний чек РУБ]
 AS [Measures].[Итоговая сумма чека со скидками РУБ]/[Measures].[Количество чеков ШТ], 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Чеки';                              
CREATE MEMBER CURRENTCUBE.[Measures].[Наценка Торнадо РУБ]
 AS [Measures].[Продажи Торнадо РУБ]-[Measures].[Себестоимость Торнадо РУБ], 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Торнадо';                              
CREATE MEMBER CURRENTCUBE.[Measures].[Количество проданного с учетом возвратов + Торнадо ШТ КГ]
 AS [Measures].[Количество проданного с учетом возвратов ШТ КГ]+[Measures].[Продажи Торнадо ШТ], 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Торнадо';                              
CREATE MEMBER CURRENTCUBE.[Measures].[Продажи с учетом возвратов и скидок + Торнадо РУБ ]
 AS [Measures].[Продажи с учетом возвратов и скидок РУБ]+[Measures].[Продажи Торнадо РУБ], 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Торнадо';                              
CREATE MEMBER CURRENTCUBE.[Measures].[Себестоимость продаж + Торнадо РУБ]
 AS [Measures].[Себестоимость продаж РУБ]+[Measures].[Себестоимость Торнадо РУБ], 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Торнадо';                              
CREATE MEMBER CURRENTCUBE.[Measures].[Наценка + Торнадо РУБ]
 AS [Measures].[Продажи с учетом возвратов и скидок + Торнадо РУБ ]-[Себестоимость продаж + Торнадо РУБ], 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Торнадо';                              
CREATE MEMBER CURRENTCUBE.[Measures].[Наценка + Торнадо ПРОЦ]
 AS iif([Продажи с учетом возвратов и скидок + Торнадо РУБ ]-[Наценка + Торнадо РУБ]=0,null,[Наценка + Торнадо РУБ]/([Продажи с учетом возвратов и скидок + Торнадо РУБ ]-[Наценка + Торнадо РУБ])), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Торнадо';                             
CREATE MEMBER CURRENTCUBE.[Measures].[Количество Чеков  Торнадо ШТ]
 AS ([Причина товародвижения].[Категории причин товародвижения].[Причина].&amp;[999],[Количество документов]), 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Торнадо';                            
CREATE MEMBER CURRENTCUBE.[Measures].[Число чеков по товару ШТ + Торнадо]
 AS [Количество Чеков  Торнадо ШТ]+[Measures].[Число чеков по товару ШТ], 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Торнадо';                           
CREATE MEMBER CURRENTCUBE.[Measures].[Наценка (скидки) ПРОЦ]
 AS iif([Measures].[Продажи со учетом скидки РУБ]-([Measures].[Цена закупочная]*[Measures].[Количество проданного со скидкой ШТ КГ])=0,null,[Наценка (скидки) РУБ]/([Measures].[Продажи со учетом скидки РУБ]-[Наценка (скидки) РУБ])), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Скидки';                           
CREATE MEMBER CURRENTCUBE.[Measures].[Наценка (скидки) РУБ]
 AS [Measures].[Продажи со учетом скидки РУБ]-([Measures].[Цена закупочная]*[Measures].[Количество проданного со скидкой ШТ КГ]), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Скидки';                                   
CREATE MEMBER CURRENTCUBE.[Measures].[Маржинальный доход РУБ]
 AS [Наценка + Торнадо РУБ]+[Потери в закупочных ценах РУБ], 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Товародвижение';                         
CREATE MEMBER CURRENTCUBE.[Measures].[Прирост продаж к прошлому году РУБ (мес)]
